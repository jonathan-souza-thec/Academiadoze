<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.ColaboradorListPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             x:DataType="vm:ColaboradorListViewModel"
             xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application"
             xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#121212}"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <converters:FotoToImageSourceConverter x:Key="FotoToImageSourceConverter" />
        <converters:EnumDisplayConverter x:Key="EnumDisplay" />

        <DataTemplate x:Key="ColaboradorItemTemplate" x:DataType="dto:ColaboradorDto">
            <Grid Padding="1" Margin="5">
                <Border Style="{StaticResource CardBorder}" Margin="10">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          ColumnDefinitions="*,Auto,Auto">

                        <!-- Foto do colaborador -->
                        <Image Grid.Row="0" Grid.Column="1"
                               Grid.ColumnSpan="2" Grid.RowSpan="9"
                               Source="{Binding Foto, Converter={StaticResource FotoToImageSourceConverter}}"
                               Aspect="AspectFill"
                               Margin="0,0,10,0">
                            <Image.HeightRequest>
                                <OnIdiom x:TypeArguments="x:Double">
                                    <OnIdiom.Phone>110</OnIdiom.Phone>
                                    <OnIdiom.Tablet>120</OnIdiom.Tablet>
                                    <OnIdiom.Desktop>120</OnIdiom.Desktop>
                                    <OnIdiom.TV>140</OnIdiom.TV>
                                    <OnIdiom.Default>110</OnIdiom.Default>
                                </OnIdiom>
                            </Image.HeightRequest>
                            <Image.WidthRequest>
                                <OnIdiom x:TypeArguments="x:Double">
                                    <OnIdiom.Phone>110</OnIdiom.Phone>
                                    <OnIdiom.Tablet>120</OnIdiom.Tablet>
                                    <OnIdiom.Desktop>120</OnIdiom.Desktop>
                                    <OnIdiom.TV>140</OnIdiom.TV>
                                    <OnIdiom.Default>110</OnIdiom.Default>
                                </OnIdiom>
                            </Image.WidthRequest>
                        </Image>

                        <!-- Dados do colaborador -->
                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding Nome}" FontAttributes="Bold" FontSize="16" Margin="0,0,0,5"/>
                        <Label Grid.Row="1" Grid.Column="0" Text="{Binding Cpf, StringFormat='CPF: {0}'}" Margin="0,0,0,5"/>
                        <Label Grid.Row="2" Grid.Column="0" Text="{Binding Telefone, StringFormat='Telefone: {0}'}" Margin="0,0,0,5"/>
                        <Label Grid.Row="3" Grid.Column="0" Text="{Binding Email, StringFormat='E-mail: {0}'}" Margin="0,0,0,5"/>
                        <Label Grid.Row="4" Grid.Column="0" Text="{Binding DataNascimento, StringFormat='Nascimento: {0:dd/MM/yyyy}'}" Margin="0,0,0,5"/>
                        <Label Grid.Row="5" Grid.Column="0" Text="{Binding DataAdmissao, StringFormat='Admissão: {0:dd/MM/yyyy}'}" Margin="0,0,0,5"/>
                        <Label Grid.Row="6" Grid.Column="0" Text="{Binding Tipo, Converter={StaticResource EnumDisplay}, StringFormat='Cargo: {0}'}" Margin="0,0,0,5"/>
                        <Label Grid.Row="7" Grid.Column="0" Text="{Binding Vinculo, Converter={StaticResource EnumDisplay}, StringFormat='Vínculo: {0}'}" Margin="0,0,0,5"/>

                        <Label Grid.Row="8" Grid.Column="0" Margin="0,0,0,5">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding Endereco.Nome}"/>
                                    <Span Text=", "/>
                                    <Span Text="{Binding Numero}"/>
                                    <Span Text=" - "/>
                                    <Span Text="{Binding Endereco.Bairro}"/>
                                    <Span Text=", "/>
                                    <Span Text="{Binding Endereco.Cidade}"/>
                                    <Span Text=" - "/>
                                    <Span Text="{Binding Endereco.Estado}"/>
                                    <Span Text=" (CEP: "/>
                                    <Span Text="{Binding Endereco.Cep}"/>
                                    <Span Text=")"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Label Grid.Row="9" Grid.Column="0" Text="{Binding Complemento, StringFormat='Complemento: {0}'}" Margin="0,0,0,5"/>

                        <!-- Botões na última linha, fora da área da foto -->
                        <Button Grid.Row="9" Grid.Column="1" Text="" Style="{StaticResource ButtonSmall}"
                                Margin="4,0" VerticalOptions="End" Clicked="OnEditButtonClicked">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe3c9;" Color="White" Size="16"/>
                            </Button.ImageSource>
                        </Button>

                        <Button Grid.Row="9" Grid.Column="2" Text="" Style="{StaticResource ButtonDanger}"
                                Margin="4,0" VerticalOptions="End" Clicked="OnDeleteButtonClicked">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe872;" Color="White" Size="16"/>
                            </Button.ImageSource>
                        </Button>

                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <!-- Estrutura principal da página -->
    <Grid RowDefinitions="Auto,*">

        <!-- Barra de pesquisa -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="15,10">
            <Grid ColumnDefinitions="Auto,10,*,10,Auto" VerticalOptions="Center">
                <Picker Grid.Column="0" Title=""
                        ItemsSource="{Binding FilterTypes}"
                        SelectedItem="{Binding SelectedFilterType}"
                        WidthRequest="110" HorizontalOptions="Start"
                        HeightRequest="40" VerticalOptions="Center"/>

                <Entry Grid.Column="2"
                       Text="{Binding SearchText}"
                       Placeholder="Digite o valor..."
                       HeightRequest="40" VerticalOptions="Center"
                       ClearButtonVisibility="WhileEditing"
                       ReturnCommand="{Binding SearchColaboradoresCommand}"/>

                <Button Grid.Column="4" Text="" Style="{StaticResource ButtonPrimary}"
                        FontSize="14" WidthRequest="80" HeightRequest="40"
                        Command="{Binding SearchColaboradoresCommand}">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe8b6;" Color="White" Size="20"/>
                    </Button.ImageSource>
                </Button>
            </Grid>
        </Border>

        <!-- Lista + FAB -->
        <Grid Grid.Row="1">
            <RefreshView IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshCommand}"
                         RefreshColor="{AppThemeBinding Light=#E8500A, Dark=#FF7B3A}">

                <CollectionView ItemsSource="{Binding Colaboradores}"
                                SelectionMode="None"
                                Margin="10">

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical">
                            <GridItemsLayout.Span>
                                <OnIdiom x:TypeArguments="x:Int32">
                                    <OnIdiom.Phone>1</OnIdiom.Phone>
                                    <OnIdiom.Default>1</OnIdiom.Default>
                                    <OnIdiom.Tablet>2</OnIdiom.Tablet>
                                    <OnIdiom.Desktop>3</OnIdiom.Desktop>
                                    <OnIdiom.TV>4</OnIdiom.TV>
                                </OnIdiom>
                            </GridItemsLayout.Span>
                        </GridItemsLayout>
                    </CollectionView.ItemsLayout>

                    <CollectionView.EmptyView>
                        <StackLayout VerticalOptions="Center" Spacing="12">
                            <Label Text="Nenhum colaborador encontrado"
                                   HorizontalOptions="Center"
                                   Style="{StaticResource SubHeadline}"/>
                            <Button Text="Adicionar Primeiro Colaborador"
                                    Command="{Binding AddColaboradorCommand}"
                                    Style="{StaticResource ButtonPrimary}"
                                    HeightRequest="50" Margin="20,0"/>
                        </StackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <StaticResource Key="ColaboradorItemTemplate"/>
                    </CollectionView.ItemTemplate>

                </CollectionView>
            </RefreshView>

            <!-- FAB circular -->
            <Button Text="" Command="{Binding AddColaboradorCommand}"
                    Style="{StaticResource ButtonFAB}"
                    HorizontalOptions="End" VerticalOptions="End"
                    Margin="0,0,20,24">
                <Button.ImageSource>
                    <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe145;" Color="White" Size="28"/>
                </Button.ImageSource>
            </Button>
        </Grid>

        <!-- Loading overlay -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                BackgroundColor="{AppThemeBinding Light=#80FFFFFF, Dark=#80000000}"
                StrokeThickness="0"
                IsVisible="{Binding IsBusy}">
            <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}"
                               Color="{AppThemeBinding Light=#E8500A, Dark=#FF7B3A}"
                               VerticalOptions="Center" HorizontalOptions="Center"/>
        </Border>

    </Grid>

</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
    x:Class="AcademiaDoZe.Presentation.AppMaui.Views.DashboardListPage"
    x:DataType="vm:DashboardListViewModel"
    BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#121212}"
    Title="{Binding Title}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="0">

                <!-- ── Banner superior ── -->
                <Grid HeightRequest="200"
                      BackgroundColor="{AppThemeBinding Light=#E8500A, Dark=#2A1A10}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Logo com fundo branco garantindo visibilidade em ambos os temas -->
                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 20"
                            WidthRequest="120" HeightRequest="120"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Padding="8">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,4" Radius="16" Opacity="0.25"/>
                        </Border.Shadow>
                        <Image Source="academiadoze.png"
                               HeightRequest="100" WidthRequest="100"
                               Aspect="AspectFit"/>
                    </Border>

                    <Label Text="Jonathan de Souza Pereira"
                           TextColor="#FFD0B8"
                           FontSize="12"
                           HorizontalOptions="Center"
                           VerticalOptions="End"
                           Margin="0,0,0,12"/>
                </Grid>

                <!-- ── Título ── -->
                <VerticalStackLayout Padding="20,20,20,8" Spacing="4">
                    <Label Text="Academia do Zé"
                           Style="{StaticResource Headline}"/>
                    <Label Text="Sistema de Gerenciamento"
                           Style="{StaticResource SubHeadline}"/>
                </VerticalStackLayout>

                <!-- ── Card de estatística: logradouros ── -->
                <Border Style="{StaticResource CardElevated}" Margin="20,8">
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">

                        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                BackgroundColor="{AppThemeBinding Light=#FFF0E8, Dark=#3A2010}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                WidthRequest="56" HeightRequest="56"
                                Padding="0"
                                VerticalOptions="Center"
                                Margin="0,0,14,0">
                            <Label Text="&#xe7f1;"
                                   FontFamily="MaterialIcons"
                                   FontSize="28"
                                   TextColor="{AppThemeBinding Light=#E8500A, Dark=#FF7B3A}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>

                        <Label Grid.Row="0" Grid.Column="1"
                               Text="Logradouros cadastrados"
                               Style="{StaticResource LabelFieldTitle}"
                               VerticalOptions="End"/>

                        <Label Grid.Row="1" Grid.Column="1"
                               Text="{Binding TotalLogradouros}"
                               Style="{StaticResource StatNumber}"
                               FontSize="32"
                               HorizontalOptions="Start"
                               VerticalOptions="Start"/>

                        <Label Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                               Text="&#xe5c8;"
                               FontFamily="MaterialIcons"
                               FontSize="22"
                               TextColor="{AppThemeBinding Light=#BDBDBD, Dark=#616161}"
                               VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- ── Botão de acesso rápido ── -->
                <Border Style="{StaticResource CardElevated}" Margin="20,8">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Acesso rápido"
                               Style="{StaticResource LabelFieldTitle}"/>

                        <Button Text="Gerenciar Logradouros"
                                Command="{Binding NavigateToLogradourosCommand}"
                                Style="{StaticResource ButtonPrimary}">
                            <Button.ImageSource>
                                <FontImageSource
                                    FontFamily="MaterialIcons"
                                    Glyph="&#xe7f1;"
                                    Color="White"
                                    Size="20"/>
                            </Button.ImageSource>
                        </Button>

                    </VerticalStackLayout>
                </Border>

                <BoxView HeightRequest="32" BackgroundColor="Transparent"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ActivityIndicator sobreposto -->
        <Border BackgroundColor="{AppThemeBinding Light=#80FFFFFF, Dark=#80000000}"
                StrokeThickness="0"
                IsVisible="{Binding IsBusy}">
            <ActivityIndicator
                IsVisible="{Binding IsBusy}"
                IsRunning="{Binding IsBusy}"
                Color="{AppThemeBinding Light=#E8500A, Dark=#FF7B3A}"
                VerticalOptions="Center"
                HorizontalOptions="Center"/>
        </Border>

    </Grid>

</ContentPage>
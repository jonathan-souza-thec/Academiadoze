<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
    x:Class="AcademiaDoZe.Presentation.AppMaui.Views.DashboardListPage"
    x:DataType="vm:DashboardListViewModel"
    Title="{Binding Title}">

    <Grid>
        <VerticalStackLayout
            Padding="20"
            Spacing="20">

            <!-- Fundo branco: a logo (com o seu nome) fica visível também no tema escuro -->
            <Border
                BackgroundColor="White"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16"
                HorizontalOptions="Center"
                Padding="8">
                <Image
                    Source="academiadoze.png"
                    HeightRequest="200"
                    WidthRequest="200" />
            </Border>

            <Label
                Text="Academia do Zé"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Sistema de Gerenciamento"
                FontSize="18"
                HorizontalOptions="Center" />

            <!-- Total de itens -->
            <Border
                Padding="20"
                StrokeThickness="1"
                HorizontalOptions="Center">
                <VerticalStackLayout Spacing="5">
                    <Label
                        FontFamily="MaterialIcons"
                        Text="&#xe7f1;"
                        FontSize="32"
                        HorizontalOptions="Center" />
                    <Label
                        Text="{Binding TotalLogradouros}"
                        FontSize="36"
                        FontAttributes="Bold"
                        HorizontalOptions="Center" />
                    <Label
                        Text="Logradouros cadastrados"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <Button
                Text="Abrir Logradouros"
                Command="{Binding NavigateToLogradourosCommand}">
                <Button.ImageSource>
                    <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe7f1;" />
                </Button.ImageSource>
            </Button>

        </VerticalStackLayout>

        <ActivityIndicator
            IsVisible="{Binding IsBusy}"
            IsRunning="{Binding IsBusy}"
            VerticalOptions="Center"
            HorizontalOptions="Center" />
    </Grid>

</ContentPage>



<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AcademiaDoZe.Presentation.AppMaui.Views.DashboardListPage"
    Title="Dashboard">

    <VerticalStackLayout
        Padding="20"
        Spacing="20">

        <Image
            Source="academiadoze.png"
            HeightRequest="180"
            WidthRequest="180"
            HorizontalOptions="Center" />

        <Label
            Text="Academia do Zé"
            FontSize="28"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Label
            Text="Sistema de Gerenciamento"
            FontSize="18"
            HorizontalOptions="Center" />

        <Button
            Text="Abrir Logradouros"
            Clicked="OnLogradourosClicked" />

    </VerticalStackLayout>

</ContentPage>
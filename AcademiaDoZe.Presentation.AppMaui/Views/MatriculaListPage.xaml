<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.MatriculaListPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             x:DataType="vm:MatriculaListViewModel"
             xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application"
             xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#121212}"
             Title="{Binding Title}">

    <!-- Recursos da Página -->
    <ContentPage.Resources>
        <converters:FotoToImageSourceConverter x:Key="FotoToImageSourceConverter" />
        <converters:EnumDisplayConverter x:Key="EnumDisplay" />
        <converters:RestricoesFlagsDisplayConverter x:Key="RestricoesDisplay" />

        <!-- Template único para Phone, Tablet, Desktop, TV e Default -->
        <DataTemplate x:Key="MatriculaItemTemplate" x:DataType="dto:MatriculaDto">
            <Grid Padding="1" Margin="5">
                <Border Style="{StaticResource CardBorder}" Margin="10">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto,Auto">

                        <!-- Foto (miniatura) do aluno -->
                        <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="6"
                                HeightRequest="100" WidthRequest="100"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                                Margin="0,0,10,0" VerticalOptions="Center">
                            <Image Source="{Binding AlunoMatricula.Foto, Converter={StaticResource FotoToImageSourceConverter}}"
                                   Aspect="AspectFill" HeightRequest="100" WidthRequest="100"/>
                        </Border>

                        <!-- Nome do aluno -->
                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding AlunoMatricula.Nome}"
                               FontAttributes="Bold" FontSize="16" Margin="0,0,0,2" LineBreakMode="TailTruncation"/>

                        <!-- CPF e nascimento -->
                        <Label Grid.Row="1" Grid.Column="0" Margin="0,0,0,4" FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="CPF: "/>
                                    <Span Text="{Binding AlunoMatricula.Cpf}"/>
                                    <Span Text=" • Nasc: "/>
                                    <Span Text="{Binding AlunoMatricula.DataNascimento, StringFormat='{0:dd/MM/yyyy}'}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <!-- Badge do plano -->
                        <HorizontalStackLayout Grid.Row="2" Grid.Column="0" Spacing="8" Margin="0,0,0,4">
                            <Border Padding="8,2" StrokeShape="RoundRectangle 4" StrokeThickness="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                                <Label Text="{Binding Plano, Converter={StaticResource EnumDisplay}}"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"/>
                            </Border>
                        </HorizontalStackLayout>

                        <!-- Vigência -->
                        <Label Grid.Row="3" Grid.Column="0" Margin="0,0,0,3" FontSize="12">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Vigência: " FontAttributes="Bold"/>
                                    <Span Text="{Binding DataInicio, StringFormat='{0:dd/MM/yyyy}'}"/>
                                    <Span Text=" até "/>
                                    <Span Text="{Binding DataFim, StringFormat='{0:dd/MM/yyyy}'}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <!-- Objetivo -->
                        <Label Grid.Row="4" Grid.Column="0" Margin="0,0,0,3" FontSize="12" LineBreakMode="TailTruncation">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Objetivo: " FontAttributes="Bold"/>
                                    <Span Text="{Binding Objetivo}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <!-- Restrições médicas (enum Flags) -->
                        <Label Grid.Row="5" Grid.Column="0" Margin="0,0,0,3" FontSize="12" LineBreakMode="TailTruncation">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Restrições: " FontAttributes="Bold"/>
                                    <Span Text="{Binding RestricoesMedicas, Converter={StaticResource RestricoesDisplay}}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <!-- Observações -->
                        <Label Grid.Row="6" Grid.Column="0" Text="{Binding ObservacoesRestricoes, StringFormat='Obs: {0}'}"
                               FontSize="11" LineBreakMode="TailTruncation" Margin="0,0,0,2"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>

                        <!-- Botões editar / excluir -->
                        <Button Grid.Row="6" Grid.Column="1" Text="" Style="{StaticResource ButtonSmall}"
                                Margin="4,0" VerticalOptions="End" Clicked="OnEditButtonClicked">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe3c9;" Color="White" Size="16"/>
                            </Button.ImageSource>
                        </Button>
                        <Button Grid.Row="6" Grid.Column="2" Text="" Style="{StaticResource ButtonDanger}"
                                Margin="4,0" VerticalOptions="End" Clicked="OnDeleteButtonClicked">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe872;" Color="White" Size="16"/>
                            </Button.ImageSource>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Barra de pesquisa -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="15,10">
            <Grid ColumnDefinitions="Auto,10,*,10,Auto" VerticalOptions="Center">
                <Picker Grid.Column="0" Title="" ItemsSource="{Binding FilterTypes}"
                        SelectedItem="{Binding SelectedFilterType}"
                        WidthRequest="140" HorizontalOptions="Start" HeightRequest="40" VerticalOptions="Center"/>
                <Entry Grid.Column="2" Text="{Binding SearchText}" Placeholder="Digite o valor..."
                       HeightRequest="40" VerticalOptions="Center" ClearButtonVisibility="WhileEditing"
                       ReturnCommand="{Binding SearchMatriculasCommand}"/>
                <Button Grid.Column="4" Text="" Style="{StaticResource ButtonPrimary}" FontSize="14"
                        WidthRequest="80" HeightRequest="40" Command="{Binding SearchMatriculasCommand}">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe8b6;" Color="White" Size="20"/>
                    </Button.ImageSource>
                </Button>
            </Grid>
        </Border>

        <!-- Lista/grade + FAB -->
        <Grid Grid.Row="1">
            <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}"
                         RefreshColor="{AppThemeBinding Light=#E8500A, Dark=#FF7B3A}">
                <CollectionView ItemsSource="{Binding Matriculas}" SelectionMode="None" Margin="10">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical">
                            <GridItemsLayout.Span>
                                <OnIdiom x:TypeArguments="x:Int32">
                                    <OnIdiom.Phone>1</OnIdiom.Phone>
                                    <OnIdiom.Default>1</OnIdiom.Default>
                                    <OnIdiom.Tablet>2</OnIdiom.Tablet>
                                    <OnIdiom.Desktop>3</OnIdiom.Desktop>
                                    <OnIdiom.TV>4</OnIdiom.TV>
                                </OnIdiom>
                            </GridItemsLayout.Span>
                        </GridItemsLayout>
                    </CollectionView.ItemsLayout>

                    <CollectionView.EmptyView>
                        <StackLayout VerticalOptions="Center" Spacing="12">
                            <Label Text="Nenhuma matrícula encontrada" HorizontalOptions="Center" Style="{StaticResource SubHeadline}"/>
                            <Button Text="Adicionar Primeira Matrícula" Command="{Binding AddMatriculaCommand}"
                                    Style="{StaticResource ButtonPrimary}" HeightRequest="50" Margin="20,0"/>
                        </StackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <StaticResource Key="MatriculaItemTemplate"/>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <!-- FAB -->
            <Button Text="" Command="{Binding AddMatriculaCommand}" Style="{StaticResource ButtonFAB}"
                    HorizontalOptions="End" VerticalOptions="End" Margin="0,0,20,24">
                <Button.ImageSource>
                    <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe145;" Color="White" Size="28"/>
                </Button.ImageSource>
            </Button>
        </Grid>

        <!-- Loading overlay -->
        <Border Grid.Row="0" Grid.RowSpan="2" BackgroundColor="{AppThemeBinding Light=#80FFFFFF, Dark=#80000000}"
                StrokeThickness="0" IsVisible="{Binding IsBusy}">
            <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}"
                               Color="{AppThemeBinding Light=#E8500A, Dark=#FF7B3A}"
                               VerticalOptions="Center" HorizontalOptions="Center"/>
        </Border>
    </Grid>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
    x:Class="AcademiaDoZe.Presentation.AppMaui.Views.AcessoPage"
    x:DataType="vm:AcessoViewModel"
    Title="{Binding Title}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="16">

                <!-- Modo: Aluno / Colaborador -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Controle de Acesso / Catraca" FontSize="24" HorizontalOptions="Center" />
                        <Label Text="Selecione se o acesso é de um Aluno ou Colaborador:" FontSize="12" HorizontalOptions="Center" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="Aluno" Style="{StaticResource ButtonPrimary}"
                                    Command="{Binding SelecionarAlunoCommand}" />
                            <Button Grid.Column="1" Text="Colaborador" Style="{StaticResource ButtonPrimary}"
                                    Command="{Binding SelecionarColaboradorCommand}" />
                        </Grid>
                        <Label Text="{Binding ModoTexto}" FontSize="12" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Localizar pessoa -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Localizar Pessoa" FontSize="20" HorizontalOptions="Center" />
                        <Entry Text="{Binding SearchText}" Placeholder="Digite o nome ou CPF..." ClearButtonVisibility="WhileEditing" />
                        <Label Text="{Binding RotuloSelecao}" FontAttributes="Bold" />
                        <Picker Title="Toque para escolher..."
                                ItemsSource="{Binding Pessoas}"
                                ItemDisplayBinding="{Binding Nome, x:DataType=vm:PessoaItem}"
                                SelectedItem="{Binding PessoaSelecionada}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Identificação e liberação -->
                <Border Style="{StaticResource CardBorder}" IsVisible="{Binding TemPessoa}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Identificação e Liberação" FontSize="20" HorizontalOptions="Center" />
                        <Label Text="{Binding PessoaSelecionada.Nome}" FontAttributes="Bold" FontSize="18" />
                        <Label Text="{Binding PessoaSelecionada.Descricao}" FontSize="12" />
                        <Label Text="{Binding StatusTexto}" FontAttributes="Bold" FontSize="12" />
                        <Button Text="{Binding BotaoTexto}" Style="{StaticResource ButtonPrimary}"
                                Command="{Binding RegistrarCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Resultado da operação -->
                <Border IsVisible="{Binding MensagemVisivel}"
                        BackgroundColor="{Binding MensagemCor}"
                        StrokeThickness="0" Padding="14"
                        StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding MensagemTitulo}" TextColor="White" FontAttributes="Bold" />
                        <Label Text="{Binding MensagemTexto}" TextColor="White" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <!-- Acessos registrados hoje -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Acessos Registrados Hoje" FontSize="20" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Atualizar" Style="{StaticResource ButtonSmall}"
                                    Command="{Binding AtualizarRegistrosCommand}" />
                        </Grid>

                        <CollectionView ItemsSource="{Binding RegistrosHoje}" SelectionMode="None" HeightRequest="280">
                            <CollectionView.EmptyView>
                                <Label Text="Nenhum acesso registrado hoje." HorizontalOptions="Center" Margin="0,20" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:RegistroHojeItem">
                                    <Grid ColumnDefinitions="*,Auto" Padding="0,6">
                                        <VerticalStackLayout Grid.Column="0">
                                            <Label Text="{Binding Nome}" FontAttributes="Bold" />
                                            <Label Text="{Binding Descricao}" FontSize="11" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding HoraTexto}" FontSize="11" VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Criar dados de demonstração" Style="{StaticResource ButtonSecondary}"
                        Command="{Binding CriarDadosDemoCommand}" />

            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}"
                           VerticalOptions="Center" HorizontalOptions="Center" />
    </Grid>

</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.AcessoPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
             x:DataType="vm:AcessoViewModel"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#121212}"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <converters:FotoToImageSourceConverter x:Key="FotoToImageSourceConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <StackLayout Spacing="16" Padding="0,10,0,20">

            <!-- Card 1: Modo (Aluno / Colaborador) -->
            <Border Style="{StaticResource CardBorder}" Margin="15,0">
                <StackLayout Spacing="12">
                    <Label Text="Controle de Acesso / Catraca" Style="{StaticResource SubHeadline}" HorizontalOptions="Center"/>
                    <Label Text="Selecione se o acesso é de um Aluno ou Colaborador:" FontSize="12" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Grid.Column="0" Text="Aluno" Command="{Binding SelecionarModoAlunoCommand}"
                                Style="{StaticResource ButtonPrimary}" HeightRequest="44">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe80c;" Color="White" Size="20"/>
                            </Button.ImageSource>
                        </Button>
                        <Button Grid.Column="1" Text="Colaborador" Command="{Binding SelecionarModoColaboradorCommand}"
                                Style="{StaticResource ButtonPrimary}" HeightRequest="44">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xea67;" Color="White" Size="20"/>
                            </Button.ImageSource>
                        </Button>
                    </Grid>
                    <Label Text="{Binding ModoAtualTexto}" FontAttributes="Bold" FontSize="13" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#E8500A, Dark=#FF7B3A}"/>
                </StackLayout>
            </Border>

            <!-- Card 2: Localizar pessoa -->
            <Border Style="{StaticResource CardBorder}" Margin="15,0">
                <StackLayout Spacing="12">
                    <Label Text="Localizar Pessoa" Style="{StaticResource SubHeadline}" HorizontalOptions="Center"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Entry Grid.Column="0" Text="{Binding SearchText}" Placeholder="Digite o nome ou CPF..."
                               ClearButtonVisibility="WhileEditing" ReturnCommand="{Binding SearchPessoaCommand}"/>
                        <Button Grid.Column="1" Text="Buscar" Command="{Binding SearchPessoaCommand}"
                                Style="{StaticResource ButtonPrimary}" HeightRequest="40" Padding="15,0">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe8b6;" Color="White" Size="18"/>
                            </Button.ImageSource>
                        </Button>
                    </Grid>
                    <Label Text="{Binding RotuloSelecao}" FontAttributes="Bold" FontSize="13"/>
                    <Picker Title="Toque para escolher..." ItemsSource="{Binding Pessoas}" SelectedItem="{Binding SelectedPessoa}"/>
                </StackLayout>
            </Border>

            <!-- Card 3: Identificação e liberação -->
            <Border Style="{StaticResource CardBorder}" Margin="15,0" IsVisible="{Binding HasSelecionado}">
                <StackLayout Spacing="12">
                    <Label Text="Identificação e Liberação" Style="{StaticResource SubHeadline}" HorizontalOptions="Center"/>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" VerticalOptions="Center">
                        <Border Grid.Column="0" HeightRequest="64" WidthRequest="64" StrokeShape="RoundRectangle 32"
                                Stroke="{StaticResource Primary}" StrokeThickness="2" BackgroundColor="Transparent"
                                VerticalOptions="Center">
                            <Image Source="{Binding SelectedPessoa.Foto, Converter={StaticResource FotoToImageSourceConverter}}"
                                   Aspect="AspectFill" HeightRequest="64" WidthRequest="64"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="{Binding SelectedPessoa.Nome}" FontAttributes="Bold" FontSize="16" LineBreakMode="TailTruncation"/>
                            <Label Text="{Binding SelectedPessoa.Cpf, StringFormat='CPF: {0}'}" FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"/>
                            <Border Padding="8,2" StrokeShape="RoundRectangle 4" StrokeThickness="0" HorizontalOptions="Start"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                                <Label Text="{Binding StatusTexto}" FontSize="11" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                    <Button Text="{Binding TextoBotaoRegistro}" Command="{Binding RegistrarAcessoCommand}"
                            Style="{StaticResource ButtonPrimary}" HeightRequest="50">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe897;" Color="White" Size="20"/>
                        </Button.ImageSource>
                    </Button>
                </StackLayout>
            </Border>

            <!-- Resultado: autorizado / registrado -->
            <Border Margin="15,0" Padding="14" StrokeShape="RoundRectangle 10" StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#DCFCE7, Dark=#064E3B}" IsVisible="{Binding MostrarSucesso}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="&#xe86c;" FontFamily="MaterialIcons" FontSize="26" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#166534, Dark=#86EFAC}"/>
                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="{Binding ResultadoTitulo}" FontAttributes="Bold" FontSize="15"
                               TextColor="{AppThemeBinding Light=#166534, Dark=#86EFAC}"/>
                        <Label Text="{Binding ResultadoMensagem}" FontSize="13" LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light=#166534, Dark=#BBF7D0}"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Resultado: acesso negado / erro -->
            <Border Margin="15,0" Padding="14" StrokeShape="RoundRectangle 10" StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#FEE2E2, Dark=#7F1D1D}" IsVisible="{Binding MostrarErro}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="&#xe000;" FontFamily="MaterialIcons" FontSize="26" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#991B1B, Dark=#FCA5A5}"/>
                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="{Binding ResultadoTitulo}" FontAttributes="Bold" FontSize="15"
                               TextColor="{AppThemeBinding Light=#991B1B, Dark=#FCA5A5}"/>
                        <Label Text="{Binding ResultadoMensagem}" FontSize="13" LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light=#991B1B, Dark=#FECACA}"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Card 4: Acessos registrados hoje -->
            <Border Style="{StaticResource CardBorder}" Margin="15,0">
                <StackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="Acessos Registrados Hoje" Style="{StaticResource SubHeadline}" VerticalOptions="Center"/>
                        <Button Grid.Column="1" Text="Atualizar" Command="{Binding LoadAcessosHojeCommand}"
                                Style="{StaticResource ButtonSecondary}" HeightRequest="38" Padding="12,0">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe5d5;" Color="{AppThemeBinding Light=#E8500A, Dark=#FF7B3A}" Size="18"/>
                            </Button.ImageSource>
                        </Button>
                    </Grid>
                    <CollectionView ItemsSource="{Binding AcessosHoje}" SelectionMode="None" HeightRequest="320">
                        <CollectionView.EmptyView>
                            <Label Text="Nenhum acesso registrado hoje." HorizontalOptions="Center" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"/>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:AcessoHojeItem">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,6">
                                    <Border Grid.Column="0" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 18"
                                            StrokeThickness="0" VerticalOptions="Center"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                                        <Label Text="{Binding Inicial}" HorizontalOptions="Center" VerticalOptions="Center"
                                               FontAttributes="Bold" TextColor="White"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label Text="{Binding Nome}" FontAttributes="Bold" FontSize="14" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding Descricao}" FontSize="11" LineBreakMode="WordWrap"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding Hora}" FontSize="11" VerticalOptions="Start"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </Border>

            <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}"
                               Color="{AppThemeBinding Light=#E8500A, Dark=#FF7B3A}"
                               VerticalOptions="Center" HorizontalOptions="Center"/>
        </StackLayout>
    </ScrollView>
</ContentPage>
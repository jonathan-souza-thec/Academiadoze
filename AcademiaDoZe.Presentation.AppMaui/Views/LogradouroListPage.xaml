<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.LogradouroListPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             x:DataType="vm:LogradouroListViewModel"
             xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#121212}"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*">

        <!-- ── Barra de pesquisa ── -->
        <Border Grid.Row="0"
                Style="{StaticResource CardBorder}"
                Margin="16,12,16,4">
            <Grid ColumnDefinitions="Auto,8,*,8,Auto" VerticalOptions="Center">
                <Picker Grid.Column="0"
                        Title=""
                        ItemsSource="{Binding FilterTypes}"
                        SelectedItem="{Binding SelectedFilterType}"
                        WidthRequest="110"
                        HeightRequest="42"
                        VerticalOptions="Center"
                        TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#F0F0F0}"/>

                <Entry Grid.Column="2"
                       Text="{Binding SearchText}"
                       Placeholder="Pesquisar..."
                       HeightRequest="42"
                       VerticalOptions="Center"
                       ClearButtonVisibility="WhileEditing"/>

                <Button Grid.Column="4"
                        Text="Buscar"
                        Style="{StaticResource ButtonPrimary}"
                        FontSize="13"
                        WidthRequest="76"
                        HeightRequest="42"
                        Padding="0"
                        Command="{Binding SearchLogradourosCommand}"/>
            </Grid>
        </Border>

        <!-- ── Lista ── -->
        <Grid Grid.Row="1">
            <RefreshView IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshCommand}"
                         RefreshColor="{AppThemeBinding Light=#E8500A, Dark=#FF7B3A}">

                <CollectionView ItemsSource="{Binding Logradouros}"
                                SelectionMode="None"
                                ItemsUpdatingScrollMode="KeepLastItemInView">

                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center"
                                             HorizontalOptions="Center"
                                             Spacing="16"
                                             Padding="32">
                            <Label Text="&#xe7f1;"
                                   FontFamily="MaterialIcons"
                                   FontSize="56"
                                   TextColor="{AppThemeBinding Light=#BDBDBD, Dark=#424242}"
                                   HorizontalOptions="Center"/>
                            <Label Text="Nenhum logradouro encontrado"
                                   Style="{StaticResource SubHeadline}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"/>
                            <Button Text="Adicionar Logradouro"
                                    Command="{Binding AddLogradouroCommand}"
                                    Style="{StaticResource ButtonPrimary}"
                                    HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:LogradouroDto">
                            <Border Style="{StaticResource CardElevated}"
                                    Margin="16,6">
                                <Grid RowDefinitions="Auto,Auto,Auto"
                                      ColumnDefinitions="Auto,*,Auto,Auto">

                                    <!-- Ícone de pin -->
                                    <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                                            BackgroundColor="{AppThemeBinding Light=#FFF0E8, Dark=#3A2010}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10"
                                            WidthRequest="44" HeightRequest="44"
                                            Padding="0"
                                            Margin="0,0,12,0"
                                            VerticalOptions="Center">
                                        <Label Text="&#xe55f;"
                                               FontFamily="MaterialIcons"
                                               FontSize="22"
                                               TextColor="{AppThemeBinding Light=#E8500A, Dark=#FF7B3A}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Border>

                                    <!-- Dados -->
                                    <Label Grid.Row="0" Grid.Column="1"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#F0F0F0}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Nome}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <Label Grid.Row="1" Grid.Column="1"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light=#616161, Dark=#9E9E9E}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Bairro}"/>
                                                <Span Text=" · "/>
                                                <Span Text="{Binding Cidade}"/>
                                                <Span Text=" - "/>
                                                <Span Text="{Binding Estado}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <Label Grid.Row="2" Grid.Column="1"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#E8500A, Dark=#FF7B3A}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="CEP: "/>
                                                <Span Text="{Binding Cep}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <!-- Botões ação -->
                                    <Button Grid.Row="0" Grid.RowSpan="3" Grid.Column="2"
                                            Text="Editar"
                                            Style="{StaticResource ButtonSmall}"
                                            Margin="4,0"
                                            VerticalOptions="Center"
                                            Clicked="OnEditButtonClicked"/>

                                    <Button Grid.Row="0" Grid.RowSpan="3" Grid.Column="3"
                                            Text="Excluir"
                                            Style="{StaticResource ButtonDanger}"
                                            Margin="4,0"
                                            VerticalOptions="Center"
                                            Clicked="OnDeleteButtonClicked"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>
            </RefreshView>

            <!-- FAB + -->
            <Button Text="+"
                    Command="{Binding AddLogradouroCommand}"
                    Style="{StaticResource ButtonFAB}"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="0,0,20,24"/>

            <!-- Loading -->
            <Border BackgroundColor="{AppThemeBinding Light=#80FFFFFF, Dark=#80000000}"
                    StrokeThickness="0"
                    IsVisible="{Binding IsBusy}">
                <ActivityIndicator
                    IsVisible="{Binding IsBusy}"
                    IsRunning="{Binding IsBusy}"
                    Color="{AppThemeBinding Light=#E8500A, Dark=#FF7B3A}"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"/>
            </Border>

        </Grid>

    </Grid>

</ContentPage>
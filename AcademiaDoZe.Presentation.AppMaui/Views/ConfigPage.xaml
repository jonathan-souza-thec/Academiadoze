<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AcademiaDoZe.Presentation.AppMaui.Views.ConfigPage"
    Title="Configurações">

    <ScrollView>

        <VerticalStackLayout Spacing="20">

            <!-- ================================================= -->
            <!-- TEMA                                             -->
            <!-- ================================================= -->

            <Border
                Margin="15,10"
                Padding="15"
                StrokeShape="RoundRectangle 10">

                <VerticalStackLayout Spacing="15">

                    <Label
                        Text="Tema"
                        FontSize="22"
                        FontAttributes="Bold" />

                    <VerticalStackLayout Spacing="5">

                        <Label
                            Text="Tema" />

                        <Picker
                            x:Name="TemaPicker">

                            <Picker.ItemsSource>

                                <x:Array Type="{x:Type x:String}">

                                    <x:String>light</x:String>
                                    <x:String>dark</x:String>
                                    <x:String>system</x:String>

                                </x:Array>

                            </Picker.ItemsSource>

                        </Picker>

                    </VerticalStackLayout>

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <Button
                            Grid.Column="0"
                            Text="Cancelar"
                            Clicked="OnCancelarClicked"
                            HeightRequest="45">

                            <Button.ImageSource>

                                <FontImageSource
                                    FontFamily="MaterialIcons"
                                    Glyph="&#xe5c9;" />

                            </Button.ImageSource>

                        </Button>

                        <Button
                            Grid.Column="1"
                            Text="Salvar Tema"
                            Clicked="OnSalvarTemaClicked"
                            HeightRequest="45">

                            <Button.ImageSource>

                                <FontImageSource
                                    FontFamily="MaterialIcons"
                                    Glyph="&#xe161;" />

                            </Button.ImageSource>

                        </Button>

                    </Grid>

                </VerticalStackLayout>

            </Border>


            <!-- ================================================= -->
            <!-- BANCO DE DADOS                                    -->
            <!-- ================================================= -->

            <Border
                Margin="15,10"
                Padding="15"
                StrokeShape="RoundRectangle 10">

                <VerticalStackLayout Spacing="15">

                    <Label
                        Text="Credenciais do Banco"
                        FontSize="22"
                        FontAttributes="Bold" />


                    <!-- TIPO DO BANCO -->

                    <VerticalStackLayout Spacing="5">

                        <Label
                            Text="Tipo de Gerenciador" />

                        <Picker
                            x:Name="DatabaseTypePicker"
                            SelectedIndexChanged="OnDatabaseTypeChanged" />

                    </VerticalStackLayout>


                    <!-- ================================================= -->
                    <!-- SQLITE                                            -->
                    <!-- ================================================= -->

                    <Border
                        x:Name="SqliteInfoCard"
                        IsVisible="False"
                        Padding="12"
                        StrokeShape="RoundRectangle 8">

                        <Label
                            Text="O SQLite é um banco de dados local armazenado em arquivo. Não requer servidor de rede, usuário ou senha."
                            FontSize="13" />

                    </Border>


                    <VerticalStackLayout
                        x:Name="SqliteContainer"
                        Spacing="5"
                        IsVisible="False">

                        <Label
                            Text="Caminho / Arquivo do Banco (.db)" />

                        <Entry
                            x:Name="SqliteCaminhoEntry"
                            Placeholder="Ex: db_academia_do_ze.db" />

                    </VerticalStackLayout>


                    <!-- ================================================= -->
                    <!-- SERVIDOR E BANCO                                   -->
                    <!-- ================================================= -->

                    <Grid
                        x:Name="ServidorBancoGrid"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="5">

                            <Label
                                Text="Servidor" />

                            <Entry
                                x:Name="ServidorEntry"
                                Placeholder="Digite o servidor..." />

                        </VerticalStackLayout>


                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="5">

                            <Label
                                Text="Banco" />

                            <Entry
                                x:Name="BancoEntry"
                                Placeholder="Digite o nome do banco..." />

                        </VerticalStackLayout>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- USUÁRIO E SENHA                                   -->
                    <!-- ================================================= -->

                    <Grid
                        x:Name="CredenciaisGrid"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="5">

                            <Label
                                Text="Usuário" />

                            <Entry
                                x:Name="UsuarioEntry"
                                Placeholder="Digite o usuário..." />

                        </VerticalStackLayout>


                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="5">

                            <Label
                                Text="Senha" />

                            <Entry
                                x:Name="SenhaEntry"
                                Placeholder="Digite a senha..."
                                IsPassword="True" />

                        </VerticalStackLayout>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- COMPLEMENTO                                       -->
                    <!-- ================================================= -->

                    <VerticalStackLayout Spacing="5">

                        <Label
                            x:Name="ComplementoLabel"
                            Text="Complemento" />

                        <Entry
                            x:Name="ComplementoEntry"
                            Placeholder="Digite o complemento..." />

                    </VerticalStackLayout>


                    <!-- ================================================= -->
                    <!-- BOTÕES                                             -->
                    <!-- ================================================= -->

                    <Grid
                        Margin="15,10"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <Button
                            Grid.Column="0"
                            Text="Cancelar"
                            Clicked="OnCancelarClicked"
                            HeightRequest="45">

                            <Button.ImageSource>

                                <FontImageSource
                                    FontFamily="MaterialIcons"
                                    Glyph="&#xe5c9;" />

                            </Button.ImageSource>

                        </Button>


                        <Button
                            Grid.Column="1"
                            Text="Salvar BD"
                            Clicked="OnSalvarBdClicked"
                            HeightRequest="45">

                            <Button.ImageSource>

                                <FontImageSource
                                    FontFamily="MaterialIcons"
                                    Glyph="&#xe161;" />

                            </Button.ImageSource>

                        </Button>

                    </Grid>

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
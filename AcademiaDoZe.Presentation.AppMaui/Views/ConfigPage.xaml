<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AcademiaDoZe.Presentation.AppMaui.Views.ConfigPage"
    BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#121212}"
    Title="Configurações">

    <ScrollView>

        <VerticalStackLayout Spacing="4" Padding="0,8,0,24">

            <!-- ================================================= -->
            <!-- TEMA                                              -->
            <!-- ================================================= -->

            <Border
                Style="{StaticResource CardElevated}"
                Margin="16,8">

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="Tema"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#F0F0F0}" />

                    <BoxView Style="{StaticResource Separator}" />

                    <VerticalStackLayout Spacing="4">

                        <Label
                            Text="TEMA DO APLICATIVO"
                            Style="{StaticResource LabelFieldTitle}" />

                        <Picker
                            x:Name="TemaPicker"
                            TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#F0F0F0}">

                            <Picker.ItemsSource>

                                <x:Array Type="{x:Type x:String}">

                                    <x:String>light</x:String>
                                    <x:String>dark</x:String>
                                    <x:String>system</x:String>

                                </x:Array>

                            </Picker.ItemsSource>

                        </Picker>

                    </VerticalStackLayout>

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="12">

                        <Button
                            Grid.Column="0"
                            Text="Cancelar"
                            Style="{StaticResource ButtonSecondary}"
                            Clicked="OnCancelarClicked">

                            <Button.ImageSource>

                                <FontImageSource
                                    FontFamily="MaterialIcons"
                                    Glyph="&#xe5c9;"
                                    Color="{AppThemeBinding Light=#E8500A, Dark=#FF7B3A}" />

                            </Button.ImageSource>

                        </Button>

                        <Button
                            Grid.Column="1"
                            Text="Salvar Tema"
                            Style="{StaticResource ButtonPrimary}"
                            Clicked="OnSalvarTemaClicked">

                            <Button.ImageSource>

                                <FontImageSource
                                    FontFamily="MaterialIcons"
                                    Glyph="&#xe161;"
                                    Color="{AppThemeBinding Light=#FFFFFF, Dark=#1A1A1A}" />

                            </Button.ImageSource>

                        </Button>

                    </Grid>

                </VerticalStackLayout>

            </Border>


            <!-- ================================================= -->
            <!-- BANCO DE DADOS                                    -->
            <!-- ================================================= -->

            <Border
                Style="{StaticResource CardElevated}"
                Margin="16,8">

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="Credenciais do Banco"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#F0F0F0}" />

                    <BoxView Style="{StaticResource Separator}" />


                    <!-- TIPO DO BANCO -->

                    <VerticalStackLayout Spacing="4">

                        <Label
                            Text="TIPO DE GERENCIADOR"
                            Style="{StaticResource LabelFieldTitle}" />

                        <Picker
                            x:Name="DatabaseTypePicker"
                            TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#F0F0F0}"
                            SelectedIndexChanged="OnDatabaseTypeChanged" />

                    </VerticalStackLayout>


                    <!-- ================================================= -->
                    <!-- SQLITE                                            -->
                    <!-- ================================================= -->

                    <Border
                        x:Name="SqliteInfoCard"
                        Style="{StaticResource CardAccent}"
                        IsVisible="False"
                        Padding="12">

                        <Label
                            Text="O SQLite é um banco de dados local armazenado em arquivo. Não requer servidor de rede, usuário ou senha."
                            FontSize="13"
                            TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#F0F0F0}" />

                    </Border>


                    <VerticalStackLayout
                        x:Name="SqliteContainer"
                        Spacing="4"
                        IsVisible="False">

                        <Label
                            Text="CAMINHO / ARQUIVO DO BANCO (.DB)"
                            Style="{StaticResource LabelFieldTitle}" />

                        <Entry
                            x:Name="SqliteCaminhoEntry"
                            Placeholder="Ex: db_academia_do_ze.db" />

                    </VerticalStackLayout>


                    <!-- ================================================= -->
                    <!-- SERVIDOR E BANCO                                   -->
                    <!-- ================================================= -->

                    <Grid
                        x:Name="ServidorBancoGrid"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="12">

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="4">

                            <Label
                                Text="SERVIDOR"
                                Style="{StaticResource LabelFieldTitle}" />

                            <Entry
                                x:Name="ServidorEntry"
                                Placeholder="Digite o servidor..." />

                        </VerticalStackLayout>


                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="4">

                            <Label
                                Text="BANCO"
                                Style="{StaticResource LabelFieldTitle}" />

                            <Entry
                                x:Name="BancoEntry"
                                Placeholder="Digite o nome do banco..." />

                        </VerticalStackLayout>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- USUÁRIO E SENHA                                   -->
                    <!-- ================================================= -->

                    <Grid
                        x:Name="CredenciaisGrid"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="12">

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="4">

                            <Label
                                Text="USUÁRIO"
                                Style="{StaticResource LabelFieldTitle}" />

                            <Entry
                                x:Name="UsuarioEntry"
                                Placeholder="Digite o usuário..." />

                        </VerticalStackLayout>


                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="4">

                            <Label
                                Text="SENHA"
                                Style="{StaticResource LabelFieldTitle}" />

                            <Entry
                                x:Name="SenhaEntry"
                                Placeholder="Digite a senha..."
                                IsPassword="True" />

                        </VerticalStackLayout>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- COMPLEMENTO                                       -->
                    <!-- ================================================= -->

                    <VerticalStackLayout Spacing="4">

                        <Label
                            x:Name="ComplementoLabel"
                            Text="Complemento"
                            Style="{StaticResource LabelFieldTitle}" />

                        <Entry
                            x:Name="ComplementoEntry"
                            Placeholder="Digite o complemento..." />

                    </VerticalStackLayout>


                    <!-- ================================================= -->
                    <!-- BOTÕES                                             -->
                    <!-- ================================================= -->

                    <Grid
                        Margin="0,8,0,0"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="12">

                        <Button
                            Grid.Column="0"
                            Text="Cancelar"
                            Style="{StaticResource ButtonSecondary}"
                            Clicked="OnCancelarClicked">

                            <Button.ImageSource>

                                <FontImageSource
                                    FontFamily="MaterialIcons"
                                    Glyph="&#xe5c9;"
                                    Color="{AppThemeBinding Light=#E8500A, Dark=#FF7B3A}" />

                            </Button.ImageSource>

                        </Button>


                        <Button
                            Grid.Column="1"
                            Text="Salvar BD"
                            Style="{StaticResource ButtonPrimary}"
                            Clicked="OnSalvarBdClicked">

                            <Button.ImageSource>

                                <FontImageSource
                                    FontFamily="MaterialIcons"
                                    Glyph="&#xe161;"
                                    Color="{AppThemeBinding Light=#FFFFFF, Dark=#1A1A1A}" />

                            </Button.ImageSource>

                        </Button>

                    </Grid>

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
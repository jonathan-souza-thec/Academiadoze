<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="AcademiaDoZe.Presentation.AppMaui.Views.ConfigPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#121212}"
    Title="Configurações">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="20">

            <!-- ====================================================== -->
            <!-- TEMA -->
            <!-- ====================================================== -->

            <Border
                Padding="20"
                BackgroundColor="{AppThemeBinding
                    Light={StaticResource LightSecondaryBackground},
                    Dark={StaticResource DarkSecondaryBackground}}"
                Stroke="{AppThemeBinding
                    Light={StaticResource Gray200},
                    Dark={StaticResource Gray900}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="15">

                    <Label
                        Text="Aparência"
                        FontSize="22"
                        FontAttributes="Bold" />

                    <Label
                        Text="Escolha o tema da aplicação."
                        FontSize="14"
                        TextColor="{AppThemeBinding
                            Light={StaticResource Gray600},
                            Dark={StaticResource Gray400}}" />

                    <Picker
                        x:Name="TemaPicker"
                        Title="Selecione o tema">

                        <Picker.Items>
                            <x:String>system</x:String>
                            <x:String>light</x:String>
                            <x:String>dark</x:String>
                        </Picker.Items>

                    </Picker>

                    <Button
                        Text="Salvar tema"
                        Clicked="OnSalvarTemaClicked"
                        Style="{StaticResource ButtonPrimary}" />

                </VerticalStackLayout>

            </Border>


            <!-- ====================================================== -->
            <!-- BANCO DE DADOS -->
            <!-- ====================================================== -->

            <Border
                Padding="20"
                BackgroundColor="{AppThemeBinding
                    Light={StaticResource LightSecondaryBackground},
                    Dark={StaticResource DarkSecondaryBackground}}"
                Stroke="{AppThemeBinding
                    Light={StaticResource Gray200},
                    Dark={StaticResource Gray900}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="15">

                    <Label
                        Text="Banco de dados"
                        FontSize="22"
                        FontAttributes="Bold" />

                    <Picker
                        x:Name="DatabaseTypePicker"
                        Title="Tipo de banco"
                        SelectedIndexChanged="OnDatabaseTypeChanged" />

                    <!-- ================================================== -->
                    <!-- SQLITE -->
                    <!-- ================================================== -->

                    <Border
                        x:Name="SqliteInfoCard"
                        Padding="15"
                        BackgroundColor="{AppThemeBinding
                            Light=#FFF0E8,
                            Dark=#2A1A14}"
                        Stroke="{AppThemeBinding
                            Light=#E8500A,
                            Dark=#FF7B3A}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12">

                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="SQLite"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding
                                    Light=#E8500A,
                                    Dark=#FF7B3A}" />

                            <Label
                                Text="O banco SQLite é armazenado localmente no dispositivo."
                                FontSize="13" />

                        </VerticalStackLayout>

                    </Border>


                    <VerticalStackLayout
                        x:Name="SqliteContainer"
                        Spacing="10">

                        <Label
                            Text="Caminho do banco SQLite"
                            FontAttributes="Bold" />

                        <Entry
                            x:Name="SqliteCaminhoEntry"
                            Placeholder="Ex: db_academia_do_ze.db" />

                    </VerticalStackLayout>


                    <!-- ================================================== -->
                    <!-- SERVIDOR -->
                    <!-- ================================================== -->

                    <Grid
                        x:Name="ServidorBancoGrid"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <VerticalStackLayout Grid.Column="0">

                            <Label
                                Text="Servidor"
                                FontAttributes="Bold" />

                            <Entry
                                x:Name="ServidorEntry"
                                Placeholder="Servidor" />

                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1">

                            <Label
                                Text="Banco"
                                FontAttributes="Bold" />

                            <Entry
                                x:Name="BancoEntry"
                                Placeholder="Nome do banco" />

                        </VerticalStackLayout>

                    </Grid>


                    <!-- ================================================== -->
                    <!-- CREDENCIAIS -->
                    <!-- ================================================== -->

                    <Grid
                        x:Name="CredenciaisGrid"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <VerticalStackLayout Grid.Column="0">

                            <Label
                                Text="Usuário"
                                FontAttributes="Bold" />

                            <Entry
                                x:Name="UsuarioEntry"
                                Placeholder="Usuário" />

                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1">

                            <Label
                                Text="Senha"
                                FontAttributes="Bold" />

                            <Entry
                                x:Name="SenhaEntry"
                                Placeholder="Senha"
                                IsPassword="True" />

                        </VerticalStackLayout>

                    </Grid>


                    <!-- ================================================== -->
                    <!-- COMPLEMENTO -->
                    <!-- ================================================== -->

                    <VerticalStackLayout>

                        <Label
                            x:Name="ComplementoLabel"
                            Text="Complemento"
                            FontAttributes="Bold" />

                        <Entry
                            x:Name="ComplementoEntry"
                            Placeholder="Complemento da conexão" />

                    </VerticalStackLayout>


                    <!-- ================================================== -->
                    <!-- BOTÕES -->
                    <!-- ================================================== -->

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10"
                        Margin="0,10,0,0">

                        <Button
                            Grid.Column="0"
                            Text="Salvar banco"
                            Clicked="OnSalvarBdClicked"
                            Style="{StaticResource ButtonPrimary}" />

                        <Button
                            Grid.Column="1"
                            Text="Cancelar"
                            Clicked="OnCancelarClicked"
                            Style="{StaticResource ButtonSecondary}" />

                    </Grid>

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>